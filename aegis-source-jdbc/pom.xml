<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.vaquarkhan.aegis</groupId>
    <artifactId>aegis-gateway-2-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>aegis-source-jdbc</artifactId>
  <name>Aegis 2.0 JDBC source</name>
  <description>A governed tool source over any JDBC driver, using java.sql only. Covers the engines whose
    real control surface is SQL rather than REST: Hive (HiveServer2), Impala, Doris, Druid, Avatica and
    Phoenix, Trino, Spark Thrift. Ships NO driver: the operator puts their engine's own driver on the
    classpath, which is how JDBC is meant to work and means Aegis never redistributes someone else's
    driver. The tool surface is built from java.sql.DatabaseMetaData, so every metadata read is a typed
    call that the compiler checks rather than a URL path somebody typed.</description>

  <properties>
    <!-- Measured at review time: 84% line and 72% branch. Keep the gate below that baseline. -->
    <coverage.line.minimum>0.75</coverage.line.minimum>
    <coverage.branch.minimum>0.60</coverage.branch.minimum>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.vaquarkhan.aegis</groupId>
      <artifactId>aegis-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.vaquarkhan.aegis</groupId>
      <artifactId>aegis-config</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Apache Derby, embedded, TEST SCOPE ONLY. It is here so this module has no test double at all:
         a real JDBC driver, a real SQL engine, real DatabaseMetaData, real SQLState codes and real
         primary keys. A hand-written java.sql test double can only ever agree with whoever wrote it, which is
         the failure mode that let invented endpoints ship (see docs/contributing/DEFECT-LOG.md).
         Embedded, in-memory, no server and no container, so the default build stays offline-friendly.
         Never shipped: Aegis redistributes no JDBC driver. -->
    <dependency>
      <groupId>org.apache.derby</groupId>
      <artifactId>derby</artifactId>
      <version>${derby.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.derby</groupId>
      <artifactId>derbyshared</artifactId>
      <version>${derby.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- Derby writes derby.log into the working directory by default, which leaves a build
                 artifact in the module root and then fails the license check. Keep it under target. -->
            <derby.stream.error.file>${project.build.directory}/derby.log</derby.stream.error.file>
            <derby.system.home>${project.build.directory}/derby</derby.system.home>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
