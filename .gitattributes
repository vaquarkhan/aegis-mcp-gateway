# Legal texts are copied byte for byte into the generated META-INF/LICENSE and META-INF/NOTICE of
# every shaded jar. Keep them LF on every OS so the bundles are identical on Windows and Linux.
/LICENSE text eol=lf
/NOTICE text eol=lf
/tools/binary-legal/** text eol=lf
