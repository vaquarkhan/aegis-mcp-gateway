<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.vaquarkhan.aegis</groupId>
    <artifactId>aegis-gateway-2-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>aegis-config</artifactId>
  <name>Aegis 2.0 declarative configuration</name>
  <description>Builds a governed gateway from one JSON or YAML file: proxied MCP servers (HTTP or stdio),
    declarative HTTP tools (no Java per project), plugin tool sources via ServiceLoader, policy, approval,
    VRP, egress, audit. Strict: unknown keys are errors.</description>
  <properties>
    <!-- Coverage floor = measured default-build coverage minus about 2 points (docs/VALIDATION.md). -->
    <coverage.line.minimum>0.85</coverage.line.minimum>
    <coverage.branch.minimum>0.72</coverage.branch.minimum>
  </properties>


  <dependencies>
    <dependency>
      <groupId>io.github.vaquarkhan.aegis</groupId>
      <artifactId>aegis-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.vaquarkhan.aegis</groupId>
      <artifactId>aegis-mcp</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.vaquarkhan.aegis</groupId>
      <artifactId>aegis-observability-otlp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Optional: only needed for .yaml/.yml configuration files. JSON needs nothing. -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.github.vaquarkhan.aegis</groupId>
      <artifactId>aegis-mcp</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!-- Adds VaultKvSecretProviderIT (secrets.source: vault against a real Vault-API server, validated
         with OpenBao) to the normal tests. Needs AEGIS_VAULT_ADDR and AEGIS_VAULT_TOKEN. -->
    <profile>
      <id>vault-integration</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <includes>
                <include>**/*Test.java</include>
                <include>**/*IT.java</include>
              </includes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
