<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.vaquarkhan.aegis</groupId>
    <artifactId>aegis-gateway-2-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>aegis-state-postgres</artifactId>
  <name>Aegis 2.0 PostgreSQL shared state</name>
  <description>Optional shared multi-replica StateStore backed by real PostgreSQL transactions. Selected with
    state.type: postgres; it stores approval and receipt nonces, pending approvals, rate/budget windows and other
    governance state atomically across gateway processes.</description>
  <properties>
    <!-- Shared-state behavior is verified only by PostgresStateStoreIT against a real PostgreSQL server.
         The default no-infrastructure build compiles the provider but does not pretend to test it. -->
    <coverage.line.minimum>0.00</coverage.line.minimum>
    <coverage.branch.minimum>0.00</coverage.branch.minimum>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.vaquarkhan.aegis</groupId>
      <artifactId>aegis-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.vaquarkhan.aegis</groupId>
      <artifactId>aegis-config</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgresql.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>postgres-integration</id>
      <properties>
        <coverage.line.minimum>0.78</coverage.line.minimum>
        <coverage.branch.minimum>0.58</coverage.branch.minimum>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <includes>
                <include>**/*IT.java</include>
              </includes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
