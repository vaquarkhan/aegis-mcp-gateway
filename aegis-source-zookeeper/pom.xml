<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.vaquarkhan.aegis</groupId>
    <artifactId>aegis-gateway-2-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>aegis-source-zookeeper</artifactId>
  <name>Aegis 2.0 ZooKeeper source</name>
  <description>Governed MCP tools over the Apache ZooKeeper data tree, using ZooKeeper's own Java client.
    ZooKeeper's AdminServer serves cluster commands over HTTP, but the data tree is reached through the
    client protocol, so that is what this source speaks. Every call is a typed method on the ZooKeeper
    client, and paths are validated by ZooKeeper's own PathUtils rather than by a check written here.</description>

  <properties>
    <!-- Measured at review time: 73% line and 44% branch. Keep the gate below that baseline. -->
    <coverage.line.minimum>0.65</coverage.line.minimum>
    <coverage.branch.minimum>0.35</coverage.branch.minimum>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.vaquarkhan.aegis</groupId>
      <artifactId>aegis-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.vaquarkhan.aegis</groupId>
      <artifactId>aegis-config</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.zookeeper</groupId>
      <artifactId>zookeeper</artifactId>
      <version>${zookeeper.version}</version>
      <exclusions>
        <!--
          Choosing the SLF4J backend belongs to the operator, not to this module, so the one ZooKeeper
          happens to default to is left out. Netty is NOT excluded: ZooKeeper's client-side TLS
          (secureClientPort) is implemented on Netty, so dropping it would turn "enable TLS to
          ZooKeeper" into a NoClassDefFoundError at runtime.
        -->
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-reload4j</artifactId>
        </exclusion>
        <exclusion>
          <groupId>ch.qos.logback</groupId>
          <artifactId>logback-classic</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- A real embedded ZooKeeper server, test scope only, so this module is proven against the actual
         software rather than a stand-in. Never shipped. -->
    <dependency>
      <groupId>org.apache.curator</groupId>
      <artifactId>curator-test</artifactId>
      <version>${curator.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <!-- What an operator copies into Knox ext/ next to the Aegis bundle to use this source inside Knox:
           this module's jar plus target/plugin.classpath (its runtime dependencies, without the Aegis modules
           the bundle already contains). The ZooKeeper adopter example installs exactly this. -->
      <id>real-engines</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.8.1</version>
            <executions>
              <execution>
                <id>plugin-classpath</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>build-classpath</goal>
                </goals>
                <configuration>
                  <outputFile>${project.build.directory}/plugin.classpath</outputFile>
                  <includeScope>runtime</includeScope>
                  <excludeGroupIds>io.github.vaquarkhan.aegis,org.junit.jupiter,org.junit.platform,org.opentest4j,org.apiguardian</excludeGroupIds>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
