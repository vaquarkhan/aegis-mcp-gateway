<!--
  Knox flavor of the Spark + Iceberg tutorial. Knox authenticates (ShiroProvider against Knox's demo
  LDAP), maps people to groups (Default identity assertion) and admits the route (AclsAuthz); the
  AEGIS_MCP service then governs each MCP call with the tutorial's governance file.
  install-into-knox.* copies this to conf/topologies/ and replaces @KNOX_HOME@ with your Knox directory.
-->
<topology>
    <gateway>
        <provider>
            <role>authentication</role>
            <name>ShiroProvider</name>
            <enabled>true</enabled>
            <param><name>sessionTimeout</name><value>30</value></param>
            <param><name>main.ldapRealm</name><value>org.apache.knox.gateway.shirorealm.KnoxLdapRealm</value></param>
            <param><name>main.ldapContextFactory</name><value>org.apache.knox.gateway.shirorealm.KnoxLdapContextFactory</value></param>
            <param><name>main.ldapRealm.contextFactory</name><value>$ldapContextFactory</value></param>
            <param><name>main.ldapRealm.userDnTemplate</name><value>uid={0},ou=people,dc=hadoop,dc=apache,dc=org</value></param>
            <param><name>main.ldapRealm.contextFactory.url</name><value>ldap://localhost:33389</value></param>
            <param><name>main.ldapRealm.contextFactory.authenticationMechanism</name><value>simple</value></param>
            <param><name>urls./**</name><value>authcBasic</value></param>
        </provider>
        <provider>
            <role>identity-assertion</role>
            <name>Default</name>
            <enabled>true</enabled>
            <!-- guest reads, sam changes data, tom approves; admin has no Aegis group. -->
            <param><name>group.principal.mapping</name><value>guest=lake-readers;sam=lake-engineers;tom=lake-approvers</value></param>
        </provider>
        <provider>
            <role>authorization</role>
            <name>AclsAuthz</name>
            <enabled>true</enabled>
            <!-- Knox's route ACL: only these three people reach the Aegis service at all. -->
            <param><name>AEGIS_MCP.acl</name><value>guest,sam,tom;*;*</value></param>
        </provider>
    </gateway>
    <service>
        <role>AEGIS_MCP</role>
        <param><name>aegis.config</name><value>@KNOX_HOME@/conf/aegis/aegis-spark-iceberg.yaml</value></param>
    </service>
</topology>
