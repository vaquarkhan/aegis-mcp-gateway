{
  "inputs": [
    {
      "type": "promptString",
      "id": "knox-basic",
      "description": "Base64 of a user and password from the local Knox demo LDAP; see conf/users.ldif in that Knox installation",
      "password": true
    }
  ],
  "servers": {
    "aegis-lake-knox": {
      "type": "http",
      "url": "https://localhost:8443/gateway/aegis-spark-iceberg/aegis-mcp/v1/mcp",
      "headers": {
        "Authorization": "Basic ${input:knox-basic}"
      }
    }
  }
}
