{
  "inputs": [
    {
      "type": "promptString",
      "id": "knox-basic",
      "password": true,
      "description": "Base64 of a user and password from the local Knox demo LDAP; see conf/users.ldif in that Knox installation"
    }
  ],
  "servers": {
    "aegis-kafka-knox": {
      "type": "http",
      "url": "https://localhost:8443/gateway/aegis-kafka/aegis-mcp/v1/mcp",
      "headers": {
        "Authorization": "Basic ${input:knox-basic}"
      }
    }
  }
}
