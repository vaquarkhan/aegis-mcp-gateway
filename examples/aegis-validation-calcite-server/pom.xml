<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.vaquarkhan.aegis</groupId>
    <artifactId>aegis-gateway-2-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>aegis-validation-calcite-server</artifactId>
  <packaging>pom</packaging>
  <name>Aegis 2.0 validation: Calcite over Avatica server classpath (opt-in)</name>
  <description>No code. Resolves Apache Calcite 1.42.0 (core and the file adapter) and the Avatica standalone server
    built for it, and writes the runtime classpath to target/server.classpath, so the Calcite adopter example can run
    org.apache.calcite.avatica.standalone.StandaloneServer in front of a real Calcite JDBC connection in its own JVM.
    Only built with -Preal-engines.</description>

  <properties>
    <calcite.version>1.42.0</calcite.version>
    <!-- The Avatica release calcite-core 1.42.0 is built against. -->
    <avatica.version>1.28.0</avatica.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.calcite</groupId>
      <artifactId>calcite-core</artifactId>
      <version>${calcite.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.calcite</groupId>
      <artifactId>calcite-file</artifactId>
      <version>${calcite.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.calcite.avatica</groupId>
      <artifactId>avatica-standalone-server</artifactId>
      <version>${avatica.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>server-classpath</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>build-classpath</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.directory}/server.classpath</outputFile>
              <includeScope>runtime</includeScope>
              <excludeGroupIds>org.junit.jupiter,org.junit.platform,org.opentest4j,org.apiguardian</excludeGroupIds>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
