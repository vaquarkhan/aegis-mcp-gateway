<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.vaquarkhan.aegis</groupId>
    <artifactId>aegis-gateway-2-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>aegis-validation-activemq-server</artifactId>
  <packaging>pom</packaging>
  <name>Aegis 2.0 validation: ActiveMQ Classic broker distribution (opt-in)</name>
  <description>No code. Unpacks the official org.apache.activemq:apache-activemq 6.3.2 binary distribution
    (the same bin.zip the ActiveMQ download page links) into target/, so the ActiveMQ adopter example starts
    a stock broker with its web console and Jolokia. Only built with -Preal-engines.</description>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>unpack-distribution</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.apache.activemq</groupId>
                  <artifactId>apache-activemq</artifactId>
                  <version>6.3.2</version>
                  <classifier>bin</classifier>
                  <type>zip</type>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}/dist</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
