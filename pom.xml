<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Aegis Gateway 2.0 root build. The 0.1 modules are not part of this line; see docs/HISTORY.md. -->
  <groupId>io.github.vaquarkhan.aegis</groupId>
  <artifactId>aegis-gateway-2-parent</artifactId>
  <version>2.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Aegis Gateway 2.0 (parent)</name>
  <description>Config-driven MCP governance: one engine, two front doors (its own server and an Apache Knox extension).</description>
  <url>https://github.com/vaquarkhan/aegis-mcp-gateway</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>The Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <modules>
    <!-- The gateway itself: engine, protocol, configuration, and the two front doors. -->
    <module>aegis-engine</module>
    <module>aegis-mcp</module>
    <module>aegis-observability-otlp</module>
    <module>aegis-config</module>
    <module>aegis-mcp-guardrails</module>
    <module>aegis-mcp-security</module>
    <module>aegis-gateway</module>
    <module>aegis-source-jdbc</module>
    <module>aegis-source-zookeeper</module>
    <module>aegis-source-a2a</module>
    <module>aegis-state-derby</module>
    <module>aegis-state-postgres</module>
    <module>aegis-knox3-extension</module>
    <!-- Adoption examples, plugin sources, runnable bundles and real-engine validation. -->
    <module>examples</module>
  </modules>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Pinned versions. The engine, mcp and config modules have ZERO runtime dependencies. -->
    <junit.version>5.10.2</junit.version>
    <!-- Same snakeyaml line Apache Knox 3.0.0 ships (knox pom: snakeyaml.version=2.4). Optional only. -->
    <snakeyaml.version>2.4</snakeyaml.version>
    <!-- Exact Knox release the extension is compiled against (provided scope, never bundled). -->
    <knox.version>3.0.0</knox.version>
    <javax.ws.rs.version>2.0</javax.ws.rs.version>
    <javax.servlet.version>4.0.1</javax.servlet.version>
    <kafka.version>3.9.1</kafka.version>
    <!-- Two uses. Test scope in aegis-source-jdbc: a real embedded SQL engine so that module has no test
         double. Compile scope in aegis-state-derby: the embedded store behind state.type: derby-local, which
         the own-server aegis-gateway jar bundles. 10.16 is the line that runs on Java 17; 10.17 is compiled
         for a newer JDK and fails with UnsupportedClassVersionError here. -->
    <derby.version>10.16.1.1</derby.version>
    <!-- PostgreSQL JDBC driver for the optional shared multi-replica state provider. Pinned to the
         current locally cached pgJDBC release and exercised against a real local PostgreSQL server. -->
    <postgresql.version>42.7.12</postgresql.version>
    <zookeeper.version>3.9.3</zookeeper.version>
    <!-- Test scope only, in aegis-source-zookeeper: curator-test provides a real embedded ZooKeeper
         server so that module is proven against the actual software. Never shipped. -->
    <curator.version>5.4.0</curator.version>
    <!-- Coverage gate defaults; modules override with their measured floor. -->
    <coverage.line.minimum>0.00</coverage.line.minimum>
    <coverage.branch.minimum>0.00</coverage.branch.minimum>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.vaquarkhan.aegis</groupId>
        <artifactId>aegis-engine</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.vaquarkhan.aegis</groupId>
        <artifactId>aegis-mcp</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.vaquarkhan.aegis</groupId>
        <artifactId>aegis-config</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.vaquarkhan.aegis</groupId>
        <artifactId>aegis-gateway</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.yaml</groupId>
        <artifactId>snakeyaml</artifactId>
        <version>${snakeyaml.version}</version>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>17</release>
            <compilerArgs>
              <arg>-Xlint:all,-serial,-processing,-options</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
          <configuration>
            <trimStackTrace>false</trimStackTrace>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.rat</groupId>
          <artifactId>apache-rat-plugin</artifactId>
          <version>0.16.1</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>0.8.12</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Every source, build and documentation file must carry the Apache License 2.0 header.
           Files that cannot carry a comment (JSON data, captured logs) are excluded explicitly. -->
      <plugin>
        <groupId>org.apache.rat</groupId>
        <artifactId>apache-rat-plugin</artifactId>
        <executions>
          <execution>
            <id>license-headers</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <consoleOutput>true</consoleOutput>
          <excludes>
            <exclude>**/target/**</exclude>
            <exclude>**/*.json</exclude>
            <exclude>**/*.jsonl</exclude>
            <exclude>docs/evidence/**/*.log</exclude>
            <!-- Captured run output (transcripts, Surefire summaries) is evidence and cannot carry a header. -->
            <exclude>**/adopters/*/results/**</exclude>
            <exclude>**/dependency-reduced-pom.xml</exclude>
            <exclude>**/.idea/**</exclude>
            <exclude>**/*.iml</exclude>
          </excludes>
        </configuration>
      </plugin>
      <!-- Line/branch coverage: report per module, and a gate per module (thresholds set in each
           module from measured coverage; the gate only ever ratchets up). -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>coverage-gate</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <haltOnFailure>true</haltOnFailure>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${coverage.line.minimum}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${coverage.branch.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- mvn -Prelease package: writes an aggregate CycloneDX SBOM (target/bom.json and bom.xml)
         for supply-chain review, as the 0.1 release build did. Off in the default build. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <!-- Attach source jars for candidate review. Signing, voting and distribution remain release-process steps. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-source-jars</id>
                <phase>package</phase>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-maven-plugin</artifactId>
            <version>2.9.1</version>
            <configuration>
              <projectType>application</projectType>
              <schemaVersion>1.5</schemaVersion>
              <outputFormat>all</outputFormat>
            </configuration>
            <executions>
              <execution>
                <id>make-sbom</id>
                <phase>package</phase>
                <goals>
                  <goal>makeAggregateBom</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
