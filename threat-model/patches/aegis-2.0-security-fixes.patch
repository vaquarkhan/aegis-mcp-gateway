+                "{\"identity\":{\"type\":\"jwt\",\"jwt\":{\"issuer\":\"i\",\"audience\":\"a\",\"algorithms\":[\"HS256\"],"
+                        + "\"hmacSecretEnv\":\"JWT_SECRET\"}},\"routes\":{\"adminGroups\":[\"ops\"]}}"), dir,
