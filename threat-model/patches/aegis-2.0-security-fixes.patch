+# Static analysis and dependency scanning (threat-model AI-SCANNER-READINESS O-12 B and D).
+# SpotBugs with FindSecBugs already runs inside `mvn verify` (root pom). This workflow adds CodeQL's
+# security-extended queries and an OSV dependency scan of the CycloneDX SBOM.
+name: CodeQL and dependency scan
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+  schedule:
+    - cron: '17 4 * * 1'
+
+permissions:
+  contents: read
+
+jobs:
+  codeql:
+    name: CodeQL (java)
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+      security-events: write
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '17'
+          cache: maven
+      - uses: github/codeql-action/init@v3
+        with:
+          languages: java
+          queries: security-extended
+      - name: Build (no tests; CodeQL traces the compiler)
+        run: mvn -B -DskipTests -Djacoco.skip=true -Dspotbugs.skip=true -Drat.skip=true package
+      - uses: github/codeql-action/analyze@v3
+
+  dependencies:
+    name: SBOM and OSV scan
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '17'
+          cache: maven
+      - name: Aggregate CycloneDX SBOM
+        run: mvn -B -DskipTests -Djacoco.skip=true -Dspotbugs.skip=true -Drat.skip=true -Prelease package org.cyclonedx:cyclonedx-maven-plugin:makeAggregateBom
+      - name: Scan the SBOM with OSV
+        uses: google/osv-scanner-action/osv-scanner-action@v2
+        with:
+          scan-args: |
+            --sbom=target/bom.json
+            --format=table
