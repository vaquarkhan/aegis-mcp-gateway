+        OwnServerSecuritySettings full = OwnServerSecuritySettings.parse(Json.parseObject(
+                "{\"identity\":{\"type\":\"jwt\",\"jwt\":{\"issuer\":\"i\",\"audience\":\"a\",\"algorithms\":[\"HS256\"],"
+                        + "\"hmacSecretEnv\":\"JWT_SECRET\",\"requireJti\":true,\"requireRevocation\":true}},"
+                        + "\"routes\":{\"adminGroups\":[\"ops\"]},\"adminListen\":{\"port\":0}}"), dir, GatewayHostTest.ENV::get,
+                Clock.systemUTC());
+        AegisServer.checkCompleteControlPerimeter(true, full);
+        verdict("GAP-L4a", "shared MCP/admin listener; admin open to any authenticated caller", "host.adminListen + checkCompleteControlPerimeter",
+                "FIXED", "admin API 404 on MCP port when separated; complete control requires adminGroups, adminListen, requireJti, requireRevocation");
+    }
+}
diff --git a/aegis-knox3-extension/src/main/java/io/github/vaquarkhan/aegis/knox/KnoxIdentityBridge.java b/aegis-knox3-extension/src/main/java/io/github/vaquarkhan/aegis/knox/KnoxIdentityBridge.java
index 9734ab9..7c51670 100644
--- a/aegis-knox3-extension/src/main/java/io/github/vaquarkhan/aegis/knox/KnoxIdentityBridge.java
+++ b/aegis-knox3-extension/src/main/java/io/github/vaquarkhan/aegis/knox/KnoxIdentityBridge.java
@@ -47,6 +47,32 @@ public final class KnoxIdentityBridge {
 
     private KnoxIdentityBridge() {}
 
+    /**
+     * Gateway-side subject revocation on the Knox path. Knox gives no token id or issue time, so a
+     * subject entry refuses every request for that subject, for the primary actor and for any actor in
+     * the delegation chain until the entry expires (revoke through POST .../admin/revocations/subject/{sub}
+     * with the Knox issuer). Registers the Knox issuer so such revocations are accepted.
+     *
+     * @return the caller, or null when the caller or one of its actors is revoked
+     */
+    public static CallerIdentity unlessRevoked(CallerIdentity caller,
+                                               io.github.vaquarkhan.aegis.engine.control.TokenRevocations revocations) {
+        if (caller == null || revocations == null) {
+            return caller;
+        }
+        revocations.registerIssuer(caller.issuer());
+        if (revocations.check(caller.issuer(), null, caller.effectiveSubject(), null) != null
