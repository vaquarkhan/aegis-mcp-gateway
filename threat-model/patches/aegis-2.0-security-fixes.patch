+# limitations under the License.
+# Apache AsterixDB: governed MCP tools over the AsterixDB HTTP API, configuration only.
+# AsterixDB HTTP API (default API port 19002): GET /admin/version, GET /admin/cluster,
+# POST /query/service (SQL++), POST /admin/shutdown.
+# New in 2.0; AsterixDB had no Aegis 0.1 adapter. No kept real-engine run yet: contract test only.
+# Dry run defaults to GATEWAY (governance preflight only).
+
+gateway:
+  name: aegis-asterixdb
+
+access:
+  writeGroups: [asterixdb-operators]
+  approverGroups: [asterixdb-approvers]
+
+approval:
+  keyEnv: AEGIS_SIGNING_KEY          # >= 32 bytes; shared by every replica
+
+# AsterixDB's /query/service runs whatever SQL++ statement it is given, so the query tool below is only
+# honestly classified READ because of the sql-readonly hook. If you remove the hook, reclassify it as
+# MUTATE so every statement needs an approval. The hook is a keyword and shape guard, not a parser: the
+# control that actually enforces read-only is a read-only credential on this source.
+hooks:
+  - type: sql-readonly
+    methods: [asterixdb_run_sql_readonly]
+    settings: {arguments: [sql]}
+
+policy:
+  rules:
+    - {id: read, groups: [asterixdb-users, asterixdb-operators], classes: [READ]}
+    - {id: operate, groups: [asterixdb-operators], classes: [MUTATE, DESTRUCTIVE]}
+
+rateLimits:
+  perCallerPerMinute: 120
+  budgetPerHour: 2000
+
+egress:
+  allowCidrs: [10.0.0.0/8]           # your cluster network; the baseUrl host is allowed automatically
+
+audit:
+  file: audit/aegis-asterixdb.jsonl
+
+sources:
+  - id: asterixdb
+    type: http
+    baseUrl: http://asterixdb:19002
+    tools:
+      - name: asterixdb_version
+        description: "Server build and version, used as a liveness read."
+        class: READ
+        inputSchema: {type: object, properties: {}, additionalProperties: false}
+        request: {method: GET, path: "/admin/version"}
+
+      - name: asterixdb_cluster
+        description: "Cluster state and node roles."
+        class: READ
+        inputSchema: {type: object, properties: {}, additionalProperties: false}
+        request: {method: GET, path: "/admin/cluster"}
+
+      - name: asterixdb_run_sql_readonly
+        description: "Run a read-only SQL++ statement against the datasets."
+        class: READ
+        inputSchema:
+          type: object
+          properties: {sql: {type: string, maxLength: 4000}}
+          required: [sql]
+          additionalProperties: false
+        request:
+          method: POST
+          path: "/query/service"
+          body: {"statement": "{sql}"}
+
+      - name: asterixdb_shutdown
+        description: "Shut the cluster controller down."
+        class: DESTRUCTIVE
+        inputSchema: {type: object, properties: {}, additionalProperties: false}
+        request: {method: POST, path: "/admin/shutdown"}
