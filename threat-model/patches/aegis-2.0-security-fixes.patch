+</head>
+<body>
+  <aside class="sidebar" aria-label="Tutorials navigation">
+    <a class="brand" href="../index.html">Aegis <span>Gateway 2.0</span></a>
+    <nav>
+      <a href="#start">Start here</a>
+      <a href="#deep">Deep-dive walkthroughs</a>
