+                "session bound to principalKey (issuer, actor, subject); other caller gets 404; ids are 256-bit SecureRandom");
+    }
+
+    // ------------------------------------------------------------------ TM-09 malformed / oversized bodies
+
+    @Test
+    void tm09_oversizedAndMalformedBodies_areRefusedWithoutCrash() {
+        byte[] big = ("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"echo\",\"arguments\":{\"text\":\""
+                + "A".repeat(4000) + "\"}}}").getBytes(StandardCharsets.UTF_8);
+        McpHttpResponse r = smallLimits.handleHttp(post(big, MODERN_HEADERS), ALICE);
+        assertEquals(413, r.status(), r.bodyText());
+
+        McpHttpResponse garbage = handler.handleHttp(post("{\"jsonrpc\":\"2.0\",\"id\":".getBytes(StandardCharsets.UTF_8), MODERN_HEADERS), ALICE);
+        assertEquals(400, garbage.status(), garbage.bodyText());
+
+        StringBuilder deep = new StringBuilder("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"echo\",\"arguments\":");
+        for (int i = 0; i < 500; i++) {
+            deep.append("{\"a\":");
+        }
+        deep.append("1");
+        for (int i = 0; i < 500; i++) {
+            deep.append('}');
+        }
+        deep.append("}}");
+        McpHttpResponse nested = handler.handleHttp(post(deep.toString().getBytes(StandardCharsets.UTF_8), MODERN_HEADERS), ALICE);
+        assertTrue(nested.status() == 400 || nested.status() == 413, nested.status() + " " + nested.bodyText());
+
+        McpHttpResponse batch = handler.handleHttp(post("[{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\"}]".getBytes(StandardCharsets.UTF_8), Map.of()), ALICE);
+        assertEquals(400, batch.status());
+
+        McpHttpResponse dup = handler.handleHttp(post(("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"method\":\"tools/list\","
+                + "\"params\":{}}").getBytes(StandardCharsets.UTF_8), Map.of()), ALICE);
+        assertEquals(400, dup.status(), dup.bodyText());
+        assertEquals(0, backendCalls);
+        verdict("TM-09", "CVE-2026-67432 (Ruby SDK unbounded JSON-RPC body); CVE-2026-53965 (PHP SDK unbounded SSE buffer); CVE-2025-53366 (FastMCP validation DoS)",
+                "oversized, deeply nested, batched, duplicate-key or malformed JSON-RPC", "BLOCKED",
+                "413 over maxBytes; 400 on malformed, depth, batch, duplicate keys; handler never throws");
+    }
+
+    // ------------------------------------------------------------------ TM-16 header/body desync
+
+    @Test
+    void tm16_headerBodyDisagreement_isRefused() {
+        Map<String, Object> call = rpc("tools/call", modern(Map.of("name", "echo", "arguments", Map.of("text", "hi"))));
+        Map<String, String> h = new LinkedHashMap<>(MODERN_HEADERS);
+        h.put("Mcp-Name", "harmless_tool");
+        McpHttpResponse r = handler.handleHttp(post(call, h), ALICE);
+        assertEquals(400, r.status(), r.bodyText());
+        h.put("Mcp-Name", "echo");
+        h.put("Mcp-Method", "tools/list");
+        assertEquals(400, handler.handleHttp(post(call, h), ALICE).status());
+        assertEquals(0, backendCalls);
+        verdict("TM-16", "MCP 2026-07-28 'Server Validation'; proxy-routing desync class",
+                "intermediary routes on header while server executes body", "BLOCKED",
+                "Mcp-Name / Mcp-Method must be single-valued and equal the body -> 400 HEADER_MISMATCH");
+    }
+
+    // ------------------------------------------------------------------ second-pass items
+
+    @Test
+    void open03_adminRoutesAreGatedPerRouteEvenWithoutAdminGroups() throws Exception {
+        // Re-examination of the "admin API shares the MCP listener" finding: with adminGroups unset the
+        // perimeter admits any authenticated caller to the admin PATH, so every ROUTE must carry its own gate.
+        TestEngines.Built b = TestEngines.build(List.of(), Map.of());
+        io.github.vaquarkhan.aegis.mcp.admin.AdminApi api = new io.github.vaquarkhan.aegis.mcp.admin.AdminApi(b.engine, Set.of("approvers"), Set.of());
+        java.util.function.BiFunction<String, String, McpHttpResponse> as = (method, path) ->
+                api.handle(new McpHttpRequest(method, path, Map.of(), new byte[0]), ALICE); // analyst, not an approver
+        assertEquals(403, as.apply("GET", "/approvals").status(), "listing pending approvals needs an approver group");
+        assertEquals(404, as.apply("GET", "/approvals/apr_00000000000000000000000000000000").status(), "a stranger cannot read a request");
+        assertEquals(403, as.apply("POST", "/approvals/apr_00000000000000000000000000000000/approve").status());
+        assertEquals(403, as.apply("GET", "/catalog").status(), "catalog needs an approver group");
+        assertEquals(428, api.handle(new McpHttpRequest("POST", "/catalog/x/accept", Map.of(), new byte[0]), TestEngines.BOB).status(),
+                "even an approver must present the reviewed digest header");
+        assertEquals(404, as.apply("GET", "/audit/verify").status(), "no verifier configured: route absent");
+        assertEquals(404, as.apply("GET", "/prompts").status());
+        assertEquals(401, api.handle(new McpHttpRequest("GET", "/approvals", Map.of(), new byte[0]), null).status());
+        verdict("OPEN-03", "review re-examination (admin API on the MCP listener)", "ordinary MCP caller probing admin routes",
+                "NO-ISSUE", "every admin route carries its own authorisation (approver / requester / verifier groups, digest header); empty adminGroups only admits to the path, which requesters need to collect their own token");
+    }
+
+    @Test
+    void open07_fullSessionTable_evictsLeastRecentInsteadOfLockingEveryoneOut() {
+        io.github.vaquarkhan.aegis.engine.model.CallerIdentity[] principals = new io.github.vaquarkhan.aegis.engine.model.CallerIdentity[5];
+        for (int i = 0; i < principals.length; i++) {
+            principals[i] = io.github.vaquarkhan.aegis.engine.model.CallerIdentity.of("p" + i, Set.of("analysts"), "test", "test");
+        }
+        java.util.concurrent.atomic.AtomicLong now = new java.util.concurrent.atomic.AtomicLong(1_000_000L);
+        Clock ticking = new Clock() {
+            @Override
+            public java.time.ZoneId getZone() {
+                return java.time.ZoneOffset.UTC;
+            }
+
+            @Override
+            public Clock withZone(java.time.ZoneId zone) {
+                return this;
+            }
+
+            @Override
+            public java.time.Instant instant() {
+                return java.time.Instant.ofEpochMilli(now.getAndAdd(1_000));
+            }
+        };
+        SessionRegistry registry = new SessionRegistry(ticking, 3_600_000, 4);
+        String first = registry.create(principals[0], "2025-06-18").orElseThrow().id();
+        for (int i = 1; i < 4; i++) {
+            registry.create(principals[i], "2025-06-18").orElseThrow();
+        }
+        assertEquals(4, registry.size());
+        // BEFORE the fix: table full, nothing idle, fifth principal refused (503) for the whole idle TTL.
+        java.util.Optional<SessionRegistry.Session> fifth = registry.create(principals[4], "2025-06-18");
+        assertTrue(fifth.isPresent(), "a new principal must be admitted when the table is full");
+        assertEquals(4, registry.size());
+        assertTrue(registry.find(first, principals[0]).isEmpty(), "the least recently used session was evicted");
+        assertTrue(registry.find(fifth.get().id(), principals[4]).isPresent());
+        verdict("OPEN-07", "review finding (SessionRegistry capacity)", "session table lock-out by ~313 principals holding 32 sessions each",
+                "FIXED", "global least-recently-used eviction when full; evicted client re-initialises instead of everyone getting 503");
+    }
+
+    @Test
+    void sanity_governedCallSucceeds() {
+        McpHttpResponse ok = handler.handleHttp(post(echoCall(), MODERN_HEADERS), ALICE);
+        assertEquals(200, ok.status(), ok.bodyText());
+        assertTrue(Json.write(JsonValues.object(Json.parseObject(ok.bodyText()), "result")).contains("echo:hi"));
+        assertEquals(1, backendCalls);
+    }
+}
