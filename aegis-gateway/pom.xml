<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.vaquarkhan.aegis</groupId>
    <artifactId>aegis-gateway-2-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>aegis-gateway</artifactId>
  <name>Aegis 2.0 gateway</name>
  <description>Independent front door: JDK HTTP(S) server (Streamable HTTP) and stdio host, with its own
    identity (JWT via JWKS/HS256, or static tokens for development). No servlet container, no Jetty.</description>
  <properties>
    <!-- Coverage floor = measured default-build coverage minus about 2 points (docs/VALIDATION.md). -->
    <coverage.line.minimum>0.86</coverage.line.minimum>
    <coverage.branch.minimum>0.75</coverage.branch.minimum>
  </properties>


  <dependencies>
    <dependency>
      <groupId>io.github.vaquarkhan.aegis</groupId>
      <artifactId>aegis-config</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.vaquarkhan.aegis</groupId>
      <artifactId>aegis-mcp-guardrails</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.vaquarkhan.aegis</groupId>
      <artifactId>aegis-mcp-security</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Optional at configuration time, bundled in the own-server distribution so state.type: derby-local
         works without installing or operating a database server. The engine itself remains JDK-only. -->
    <dependency>
      <groupId>io.github.vaquarkhan.aegis</groupId>
      <artifactId>aegis-state-derby</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- PostgreSQL is the shared multi-replica provider. It is bundled so state.type: postgres works
         in the stock own-host jar; credentials remain environment-only. -->
    <dependency>
      <groupId>io.github.vaquarkhan.aegis</groupId>
      <artifactId>aegis-state-postgres</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.vaquarkhan.aegis</groupId>
      <artifactId>aegis-mcp</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <derby.stream.error.file>${project.build.directory}/derby/derby.log</derby.stream.error.file>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>all</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.vaquarkhan.aegis.gateway.Main</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Adds TwoGatewayProcessesPostgresIT (two gateway JVMs sharing one PostgreSQL namespace) to the
         normal tests. Needs AEGIS_POSTGRES_URL, AEGIS_POSTGRES_USER and AEGIS_POSTGRES_PASSWORD. -->
    <profile>
      <id>postgres-integration</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <includes>
                <include>**/*Test.java</include>
                <include>**/*IT.java</include>
              </includes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
