<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.vaquarkhan.aegis</groupId>
    <artifactId>aegis-gateway-2-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>aegis-source-a2a</artifactId>
  <name>Aegis 2.0 A2A source</name>
  <description>An Agent2Agent (A2A) protocol 1.0 agent offered to MCP clients as one governed tool. Aegis reads
    the agent card and sends JSON-RPC SendMessage calls; it is an A2A client only and offers no A2A
    endpoint of its own. JDK only: no dependencies beyond the Aegis modules.</description>

  <properties>
    <coverage.line.minimum>0.80</coverage.line.minimum>
    <coverage.branch.minimum>0.60</coverage.branch.minimum>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.vaquarkhan.aegis</groupId>
      <artifactId>aegis-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.vaquarkhan.aegis</groupId>
      <artifactId>aegis-mcp</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.vaquarkhan.aegis</groupId>
      <artifactId>aegis-config</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <!-- What an operator copies into Knox ext/ next to the Aegis bundle: this module's jar plus
           target/plugin.classpath (its runtime dependencies outside the Aegis modules, which is none). -->
      <id>real-engines</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.8.1</version>
            <executions>
              <execution>
                <id>plugin-classpath</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>build-classpath</goal>
                </goals>
                <configuration>
                  <outputFile>${project.build.directory}/plugin.classpath</outputFile>
                  <includeScope>runtime</includeScope>
                  <excludeGroupIds>io.github.vaquarkhan.aegis,org.junit.jupiter,org.junit.platform,org.opentest4j,org.apiguardian</excludeGroupIds>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
